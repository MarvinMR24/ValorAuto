# Copiar a .env en la raíz del repo (nunca se commitea, ver .gitignore).
#
# Sin este archivo, MLFLOW_TRACKING_URI cae al sqlite local (mlflow.db) y
# todo sigue funcionando offline, como hasta ahora (ver src/model/config.py).
#
# Con este archivo configurado, MLflow apunta al servidor remoto hospedado
# en DagsHub (SNARF3/ValorAutoData), cuyo almacenamiento de artifacts es
# proxied (mlflow-artifacts:/<uuid>) y no depende de rutas de archivo local
# — resuelve el riesgo R15 (ver docs/risk-register.md).
#
# MLFLOW_TRACKING_USERNAME es tu usuario de DagsHub; MLFLOW_TRACKING_PASSWORD
# es tu token de acceso de DagsHub (Settings -> Tokens), NO tu contraseña.
# Sacar el token de: https://dagshub.com/user/settings/tokens

MLFLOW_TRACKING_URI=https://dagshub.com/SNARF3/ValorAutoData.mlflow
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=
