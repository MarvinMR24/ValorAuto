{
  "expo": {
    "name": "ValorAuto",
    "slug": "valorauto",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "ValorAuto usa la cámara para fotografiar el auto que quieres tasar.",
        "NSPhotoLibraryUsageDescription": "ValorAuto necesita acceso a tus fotos para elegir la imagen del auto."
      },
      "bundleIdentifier": "com.snarf3.valorauto"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F6F1E7",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "valorauto",
    "plugins": [
      [
        "expo-image-picker",
        {
          "cameraPermission": "ValorAuto usa la cámara para fotografiar el auto que quieres tasar.",
          "photosPermission": "ValorAuto necesita acceso a tus fotos para elegir la imagen del auto."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F6F1E7"
        }
      ],
      "expo-status-bar"
    ]
  }
}
