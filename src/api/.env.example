# ==============================================================================
# ValorAuto Backend API - Variables de Entorno (.env)
# ==============================================================================
# Copiar este archivo a .env en src/api/ o en la raíz del repositorio.
# NUNCA commitear el archivo .env con credenciales reales (ver .gitignore y docs/team_charter.md).

# Puerto del servidor Express
PORT=3000

# Llave de la API de Google Gemini (Visión) - ADR-0004
# Obtener una llave en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=tu_gemini_api_key_aqui

# Modelo de Gemini para visión (gemini-3.5-flash)
GEMINI_MODEL=gemini-3.5-flash

# Umbral mínimo de confianza visual para aceptar la identificación (0.0 a 1.0) - ADR-0004 / OpenSpec
VISION_CONFIDENCE_THRESHOLD=0.6

# Timeout para la llamada a la API de Gemini en milisegundos (25 s según spec tasacion, decisión D2)
VISION_TIMEOUT_MS=25000

# Ruta a la base de datos SQLite con los precios precalculados (ADR-0007)
# Relativa a la raíz del proyecto o ruta absoluta
DB_PATH=../../data/precalc.db

# Error medio absoluto (MAE) del modelo que generó precalc.db (USD) - docs/evidence/baseline-modelo.md
BASELINE_MAE=3243

# Modelo de Gemini alternativo si el principal responde 429/503 (saturado). Por defecto:
# gemini-3.5-flash-lite si GEMINI_MODEL es gemini-3.1-flash-lite, si no gemini-3.1-flash-lite.
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Optimización de la foto en el servidor antes de enviarla a Gemini (sharp)
IMAGE_OPTIMIZATION_ENABLED=true
IMAGE_MAX_DIMENSION=800
IMAGE_JPEG_QUALITY=75

# Si el modelo no está en precalc.db, pedir a Gemini el precio de mercado en EE. UU. (USD)
PRICE_GEMINI_FALLBACK=true
